# XPulse environment example
# Copy these values into Vercel Project Settings > Environment Variables.
# Never commit real secrets.

# Groq writer/analysis provider
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# X OAuth integration
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# Database / auth / Solana variables are deployment-specific.
